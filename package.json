{
  "name": "@lroyia/dsh-book-reader",
  "version": "0.1.1",
  "description": "书架阅读器：扫描本地 EPUB / TXT / PDF / DOCX 文档建立本地书架，并在 Harness 面板中离线阅读。",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "docs/*.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bookshelf",
    "reader",
    "book",
    "epub",
    "pdf",
    "docx",
    "txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lroyia/dsh-book-reader.git"
  },
  "homepage": "https://github.com/Lroyia/dsh-book-reader#readme",
  "bugs": {
    "url": "https://github.com/Lroyia/dsh-book-reader/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT"
}
